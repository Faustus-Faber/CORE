generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  VOLUNTEER
  ADMIN
}

// Trust tier system — progressive trust levels for volunteers
// Inspired by Discourse trust levels + Stack Exchange reputation privileges
enum TrustTier {
  REPORTER   // Tier 0: submit reports, evidence, tasks with photo proof
  TRAINEE    // Tier 1: opt into crises, submit flagged observations
  RESPONDER  // Tier 2: full update powers, can vouch for others
  VETERAN    // Tier 3: co-approve trainee updates (community self-policing)
}

// FR-01: Responder approval lifecycle
enum ResponderApprovalStatus {
  APPLICANT
  UNDER_REVIEW
  APPROVED
  SUSPENDED
  REJECTED
}

// FR-10: Evidence visibility classifications
enum MediaVisibility {
  PRIVATE
  INCIDENT_TEAM
  ORGANIZATION
  REDACTED_PUBLIC
  SHARE_PACKAGE
}

// FR-08: Atomic stock ledger entry types
enum StockEntryType {
  INCREMENT
  DECREMENT
  HOLD
  RELEASE
  FULFILL
}

// FR-09: Notification delivery lifecycle
enum NotificationDeliveryState {
  QUEUED
  SENT
  DELIVERED
  FAILED
  ACKNOWLEDGED
}

// FR-11/Outbox: Background job lifecycle
enum OutboxJobState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum OutboxJobType {
  AI_TRIAGE
  EVENT_FUSION
  NOTIFICATION_DISPATCH
  PDF_GENERATION
  RESERVATION_EXPIRY
  BRIEF_GENERATION
}

// FR-02: Signal processing lifecycle
enum SignalProcessingState {
  RECEIVED
  PROCESSING
  NEEDS_REVIEW
  ACTIONABLE
  LINKED
  REJECTED
  CANCELLED
}

// FR-07: Evidence verification states
enum EvidenceVerificationState {
  SELF_REPORTED
  CORROBORATED
  COORDINATOR_VERIFIED
  OFFICIAL_CONFIRMED
  DISPUTED
  DISMISSED
}

enum OrganizationType {
  NGO
  GOVERNMENT
  COMMUNITY_NETWORK
  UNIVERSITY
  OTHER
}

enum NotificationType {
  CRISIS_ALERT
  CRISIS_UPDATE
  NGO_REPORT_PROMPT
  RESERVATION_REQUEST
  RESERVATION_APPROVED
  RESERVATION_DECLINED
  DISPATCH_ALERT
  VOUCH_RECEIVED
  TRUST_TIER_PROMOTED
  TASK_VERIFIED
  TASK_REJECTED
  CHAT_MESSAGE
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  PUBLISHED
  UNDER_REVIEW
  REJECTED
  CLARIFICATION_REQUESTED
  MERGED
}

enum IncidentType {
  FLOOD
  FIRE
  EARTHQUAKE
  BUILDING_COLLAPSE
  ROAD_ACCIDENT
  VIOLENCE
  MEDICAL_EMERGENCY
  OTHER
}

enum InteractionContext {
  RESCUE_OPERATION
  MEDICAL_AID
  SUPPLY_DISTRIBUTION
  SHELTER_MANAGEMENT
  OTHER
}

enum TaskCategory {
  RESCUE
  MEDICAL_AID
  SUPPLY_DISTRIBUTION
  SHELTER_SETUP
  CLEANUP
  COUNSELING
  TRANSPORTATION
  OTHER
}

enum TaskStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BadgeType {
  FIRST_RESPONDER
  RISING_STAR
  CRISIS_HERO
  COMMUNITY_GUARDIAN
  ELITE_VOLUNTEER
  CENTURY
  TEAM_PLAYER
}

enum CrisisResponderStatus {
  RESPONDING
  EN_ROUTE
  ON_SITE
  COMPLETED
  UNAVAILABLE
}

enum DispatchAlertStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  fullName             String
  email                String    @unique
  phone                String    @unique
  passwordHash         String
  location             String
  latitude             Float?
  longitude            Float?
  // P0-06/FR-01: Consented location metadata
  locationAccuracy     Float?
  locationSource       String?  // "GPS" | "MAP_PIN" | "TYPED"
  locationCapturedAt   DateTime?
  locationConsentVersion String?
  // P0-03: Session version for JWT invalidation
  sessionVersion       Int       @default(0)
  // FR-01: Organization scope
  organizationId       String?   @db.ObjectId
  role                 Role      @default(USER)
  avatarUrl            String?
  skills               String[]
  availability         String?
  certifications       String?
  dispatchOptIn        Boolean   @default(false)
  isBanned             Boolean   @default(false)
  isFlagged            Boolean   @default(false)
  volunteerFlagReasons String[]
  resetTokenHash       String?
  resetTokenExpiry     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Feature 3.7: Gamification
  totalPoints          Int       @default(0)
  totalVerifiedHours   Float     @default(0)

  // Trust tier — progressive trust system (replaces binary responder approval)
  trustTier            TrustTier @default(REPORTER)

  // FR-01: Responder profile (approval workflow)
  responderProfile     ResponderProfile?

  // Relations
  organization         Organization?   @relation(fields: [organizationId], references: [id])
  reviewsGiven    Review[]       @relation("ReviewsGiven")
  reviewsReceived Review[]       @relation("ReviewsReceived")
  folders         SecureFolder[] // Feature 4: Secure Documentation
  evidencePosts   EvidencePost[]
  evidenceFlags   EvidenceFlag[]
  evidencePostVersions EvidencePostVersion[]
  crisisUpdates   CrisisEventUpdate[]
  notificationSub NotificationSubscription?
  notifications   Notification[]
  reservations    Reservation[]
  volunteerTasks  VolunteerTask[]
  badges          Badge[]
  dispatchAlertLogs DispatchAlertLog[]
  crisisResponses   CrisisResponder[]
  ngoReports      NGOReport[]
  ocrScans        OCRScan[]
  claimsCreated   Claim[]
  edgesCreated    EvidenceEdge[]
  decisions       Decision[]
  assignments     Assignment[]       @relation("AssignmentVolunteer")
  assignmentsProposed Assignment[]   @relation("AssignmentProposer")
  allocationsRequested Allocation[]  @relation("AllocationRequester")
  allocationsApproved  Allocation[]  @relation("AllocationApprover")
  briefsGenerated SituationBrief[]   @relation("BriefGenerator")
  briefsReviewed  SituationBrief[]   @relation("BriefReviewer")
  auditEvents     AuditEvent[]
  draftsProposed  ActionDraft[]      @relation("DraftProposer")
  draftsConfirmed ActionDraft[]      @relation("DraftConfirmer")
  mediaAssets     MediaAsset[]
  stockEntries    StockLedgerEntry[]
  resources       Resource[]         @relation("ResourceOwner")
  fulfillments    Fulfillment[]
  outboxJobs      OutboxJob[]

  // Trust tier system: vouches given and received
  vouchesGiven    Vouch[]     @relation("VouchGiven")
  vouchesReceived Vouch[]     @relation("VouchReceived")

  // Crisis chat messages sent by this user
  crisisMessages  CrisisMessage[]

  @@index([role, isBanned])
  @@index([role, isFlagged])
  @@index([organizationId])
  @@index([trustTier])
}

model IncidentReport {
  id                      String           @id @default(auto()) @map("_id") @db.ObjectId
  reporterId              String           @db.ObjectId
  incidentTitle           String
  description             String
  incidentType            IncidentType
  locationText            String
  latitude                Float?
  longitude               Float?
  mediaFilenames          String[]
  sourceAudioFilename     String?
  detectedLanguage        String?
  languageProbability     Float?
  translatedDescription   String?
  credibilityScore        Int
  severityLevel           IncidentSeverity
  classifiedIncidentType  IncidentType
  classifiedIncidentTitle String
  spamFlagged             Boolean          @default(false)
  status                  IncidentStatus   @default(PUBLISHED)
  // P1-14: Consent for third-party AI processing of description/media
  aiConsent               Boolean          @default(false)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  crisisEvents  CrisisEventReport[]
  ocrScans      OCRScan[]
  claims        Claim[]
  aiAnalyses    AIAnalysis[]
  signals       Signal[]                @relation("SignalToReport")
  sourceAssets  SourceAsset[]           @relation("SourceAssetToReport")

  @@index([reporterId, createdAt(sort: Desc)])
  @@index([status, severityLevel])
}

model Review {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  reviewerId         String             @db.ObjectId
  volunteerId        String             @db.ObjectId
  rating             Int
  text               String
  interactionContext InteractionContext @default(OTHER)
  interactionDate    DateTime
  wouldWorkAgain     Boolean
  crisisEventId      String             @db.ObjectId
  isFlagged          Boolean            @default(false)
  flagReasons        String[]
  createdAt          DateTime           @default(now())

  reviewer    User       @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  volunteer   User       @relation("ReviewsReceived", fields: [volunteerId], references: [id])
  crisisEvent CrisisEvent @relation(fields: [crisisEventId], references: [id], onDelete: Cascade)

  @@index([volunteerId, createdAt(sort: Desc)])
  @@index([reviewerId, createdAt(sort: Desc)])
  @@index([reviewerId, volunteerId, crisisEventId])
  @@index([isFlagged])
}

model Resource {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  category          String
  quantity          Int
  originalQuantity  Int?
  unit              String
  condition         String
  address           String
  latitude          Float
  longitude         Float
  availabilityStart DateTime?
  availabilityEnd   DateTime?
  contactPreference String
  photos            String[]
  notes             String?
  status            String    @default("Available")
  userId            String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user         User              @relation("ResourceOwner", fields: [userId], references: [id], onDelete: Cascade)
  histories    ResourceHistory[]
  reservations Reservation[]
  allocations  Allocation[]
  stockEntries StockLedgerEntry[]
  @@index([latitude, longitude])
}

// Feature 4: Secure Documentation
model SecureFolder {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  crisisId    String?      @db.ObjectId // Optional link to a crisis event
  ownerId     String       @db.ObjectId
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files       FolderFile[]
  notes       FolderNote[]
  shareLinks  ShareLink[]
  ocrScans    OCRScan[]

  isDeleted Boolean   @default(false)
  isPinned  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model FolderFile {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  folderId   String       @db.ObjectId
  folder     SecureFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uploaderId String       @db.ObjectId // To track who uploaded it

  fileName    String // The original name of the file
  description String? // Optional description/caption
  fileUrl     String // URL from your storage provider (e.g., AWS S3)
  fileType    String // e.g., 'image/jpeg', 'video/mp4'
  sizeBytes   Int
  gpsLat      Float?
  gpsLng      Float?
  // FR-10: Visibility classification and AI processing consent
  visibility  MediaVisibility @default(PRIVATE)
  aiConsent   Boolean          @default(false)
  ocrScans    OCRScan[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
}

model FolderNote {
  id       String       @id @default(auto()) @map("_id") @db.ObjectId
  folderId String       @db.ObjectId
  folder   SecureFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  authorId String       @db.ObjectId

  content String
  gpsLat  Float?
  gpsLng  Float?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ShareLink {
  id       String       @id @default(auto()) @map("_id") @db.ObjectId
  folderId String       @db.ObjectId
  folder   SecureFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  token     String    @unique
  expiresAt DateTime?
  isRevoked Boolean   @default(false)

  createdAt DateTime @default(now())
}

enum CrisisEventStatus {
  REPORTED
  VERIFIED
  UNDER_INVESTIGATION
  RESPONSE_IN_PROGRESS
  CONTAINED
  RESOLVED
  CLOSED
}

enum CrisisUpdateType {
  STATUS_CHANGE
  FIELD_OBSERVATION
  ACCESS_UPDATE
  IMPACT_UPDATE
  RESOURCE_NEED
  CLOSURE_NOTE
  ADMIN_CORRECTION
  RESPONDER_STATUS
}

enum CrisisUpdateVerificationStatus {
  SELF_REPORTED
  CORROBORATED
  COORDINATOR_VERIFIED
  OFFICIAL_CONFIRMED
  DISPUTED
  DISMISSED
  RESPONDER_CONFIRMED
  ADMIN_CONFIRMED
  SYSTEM_LOGGED
}

enum CrisisAccessStatus {
  OPEN
  LIMITED
  BLOCKED
  UNKNOWN
}

model CrisisEvent {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  // Canonical human-readable ID (e.g. "FLOOD-2024-0001") — stable across renames/merges
  canonicalId   String?           @unique
  title         String
  incidentType  IncidentType
  severityLevel IncidentSeverity
  locationText  String
  latitude      Float?
  longitude     Float?
  status        CrisisEventStatus @default(REPORTED)
  // FR-05: Optimistic concurrency version
  version       Int               @default(1)
  // FR-01: Organization scope
  organizationId String?          @db.ObjectId
  sitRepText    String?
  reportCount   Int               @default(0)
  reporterCount Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  organization  Organization?     @relation(fields: [organizationId], references: [id])
  reports CrisisEventReport[]
  updates CrisisEventUpdate[]
  conflictResolutions ConflictResolution[]
  reviews Review[]
  responders CrisisResponder[]
  dispatchAlertLogs DispatchAlertLog[]
  ngoReports NGOReport[]
  ocrScans OCRScan[]
  aiAnalyses AIAnalysis[]
  claims Claim[]
  decisions Decision[]
  needs Need[]
  sourceAssets SourceAsset[]
  assignments Assignment[]
  briefs SituationBrief[]
  actionDrafts ActionDraft[]
  mediaAssets  MediaAsset[]
  evidencePosts EvidencePost[]
  outboxJobs   OutboxJob[]

  @@index([status, severityLevel, createdAt(sort: Desc)])
  @@index([latitude, longitude])
  @@index([organizationId])
}

model CrisisEventReport {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  crisisEventId    String   @db.ObjectId
  incidentReportId String   @db.ObjectId
  createdAt        DateTime @default(now())

  crisisEvent    CrisisEvent    @relation(fields: [crisisEventId], references: [id], onDelete: Cascade)
  incidentReport IncidentReport @relation(fields: [incidentReportId], references: [id], onDelete: Cascade)

  @@unique([crisisEventId, incidentReportId])
  // AC-04.3: A report can only be linked to one crisis event (prevents duplicate fusion)
  @@unique([incidentReportId])
  @@index([crisisEventId])
}

model CrisisResponder {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  crisisEventId String               @db.ObjectId
  volunteerId   String               @db.ObjectId
  status        CrisisResponderStatus @default(RESPONDING)
  optedInAt     DateTime             @default(now())
  lastStatusAt  DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  crisisEvent CrisisEvent @relation(fields: [crisisEventId], references: [id], onDelete: Cascade)
  volunteer  User        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([crisisEventId, volunteerId])
  @@index([crisisEventId, status, updatedAt(sort: Desc)])
  @@index([volunteerId, status, updatedAt(sort: Desc)])
}

model EvidencePost {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id])
  crisisEventId  String?  @db.ObjectId
  crisisEvent    CrisisEvent? @relation(fields: [crisisEventId], references: [id])
  title          String
  description    String
  location       String
  latitude       Float?
  longitude      Float?
  mediaUrls      String[] // Local filenames or URLs
  mediaType      String // 'IMAGE' or 'VIDEO'
  isVerified     Boolean  @default(false)
  // AC-10.04: Visibility controls who can see this evidence
  visibility     MediaVisibility @default(REDACTED_PUBLIC)
  // AC-10.3: Version tracking — increments on each edit, original preserved in EvidencePostVersion
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  flags    EvidenceFlag[]
  versions EvidencePostVersion[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([crisisEventId, createdAt(sort: Desc)])
}

// AC-10.3: Append-only version history for evidence posts
model EvidencePostVersion {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  evidencePostId  String   @db.ObjectId
  version         Int
  title           String
  description     String
  editedById      String   @db.ObjectId
  editedAt        DateTime @default(now())

  evidencePost EvidencePost @relation(fields: [evidencePostId], references: [id], onDelete: Cascade)
  editedBy     User         @relation(fields: [editedById], references: [id])

  @@index([evidencePostId, version(sort: Desc)])
}

model ResourceHistory {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  resourceId   String   @db.ObjectId
  oldStatus    String
  newStatus    String
  oldQuantity  Int
  newQuantity  Int
  createdAt    DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model Reservation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  resourceId  String   @db.ObjectId
  quantity    Int
  status      String   // Pending | Approved | Declined | Expired
  justification String
  pickupTime  DateTime?
  decisionReason String?
  createdAt   DateTime @default(now())
  
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model EvidenceFlag {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  postId    String       @db.ObjectId
  post      EvidencePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String       @db.ObjectId
  user      User         @relation(fields: [userId], references: [id])
  reason    String
  createdAt DateTime     @default(now())

  @@index([postId])
}

model CrisisEventUpdate {
  id                     String                          @id @default(auto()) @map("_id") @db.ObjectId
  crisisEventId          String                          @db.ObjectId
  crisisEvent            CrisisEvent                     @relation(fields: [crisisEventId], references: [id], onDelete: Cascade)
  updaterId              String                          @db.ObjectId
  updater                User                            @relation(fields: [updaterId], references: [id])
  previousStatus         CrisisEventStatus
  newStatus              CrisisEventStatus
  updateNote             String
  updateType             CrisisUpdateType?
  verificationStatus     CrisisUpdateVerificationStatus?
  newSeverity            IncidentSeverity?
  affectedArea           String?
  accessStatus           CrisisAccessStatus?
  casualtyCount          Int?
  displacedCount         Int?
  damageNotes            String?
  resourceNeedsText      String?
  closureAreaSafe        Boolean?
  closurePeopleAccounted Boolean?
  closureNeedsStabilized Boolean?
  isFlagged              Boolean                         @default(false)
  dismissedById          String?                         @db.ObjectId
  dismissedAt            DateTime?
  createdAt              DateTime                        @default(now())

  @@index([crisisEventId, createdAt(sort: Desc)])
}

// AI-generated conflict resolution for simultaneous conflicting status changes
model ConflictResolution {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  crisisEventId   String   @db.ObjectId
  crisisEvent     CrisisEvent @relation(fields: [crisisEventId], references: [id], onDelete: Cascade)
  updateIds       String[] @db.ObjectId  // IDs of the conflicting CrisisEventUpdate entries
  recommendation  String   // AI recommendation text
  recommendedUpdateId String? @db.ObjectId  // Which update the AI recommends
  reasoning       String?  // AI reasoning for the recommendation
  resolved        Boolean  @default(false)  // Admin has made a decision
  resolvedById    String?  @db.ObjectId
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([crisisEventId])
}

model NotificationSubscription {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  userId          String            @db.ObjectId
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  incidentTypes   IncidentType[]
  radiusKm        Float             @default(10)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId])
  @@index([userId, isActive])
}

model Notification {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  userId          String            @db.ObjectId
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  crisisEventId   String?           @db.ObjectId
  title           String
  body            String
  survivalInstruction String?
  isRead          Boolean           @default(false)
  // FR-09: Delivery lifecycle
  deliveryState   NotificationDeliveryState @default(QUEUED)
  attemptCount    Int               @default(0)
  dedupeKey       String?  // recipient + event version + notification type
  acknowledgedAt  DateTime?
  channel         String?  // "IN_APP" | "EMAIL" | "WEB_PUSH"
  createdAt       DateTime          @default(now())
  reservationId String? @db.ObjectId
  type NotificationType?
  statusSnapshot  String?  // "REQUESTED | APPROVED | DECLINED"

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([dedupeKey])
}

// §19: Web Push subscription for browser push notifications
model PushSubscription {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  endpoint    String   @unique
  keys        Json     // { p256dh, auth }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ── Feature 3.7: Volunteer Timesheet & Gamification ─────────────────────────

model VolunteerTask {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  volunteerId     String       @db.ObjectId
  volunteer       User         @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        TaskCategory
  hoursSpent      Float
  dateOfTask      DateTime
  crisisEventId   String?      @db.ObjectId
  status          TaskStatus   @default(PENDING)
  pointsAwarded   Int          @default(0)
  evidenceUrls    String[]
  verifiedById    String?      @db.ObjectId
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([volunteerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([crisisEventId])
}

model Badge {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeType   BadgeType
  awardedAt   DateTime  @default(now())

  @@unique([userId, badgeType])
  @@index([userId])
}

// ── Feature 3.3: Volunteer Crisis Opt-In & Dispatch Email Alerts ────────────

model DispatchAlertLog {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  userId            String            @db.ObjectId
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  crisisEventId     String?           @db.ObjectId
  crisisEvent       CrisisEvent?      @relation(fields: [crisisEventId], references: [id])
  emailMasked       String
  status            DispatchAlertStatus
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime          @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([crisisEventId, createdAt(sort: Desc)])
}

model NGOReport {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  crisisEventId  String      @db.ObjectId
  generatedById  String      @db.ObjectId
  title          String
  fileUrl        String?
  summary        String?
  // Editable sections populated from crisis data; admin can edit before PDF generation
  sectionsJson   String?
  // Whether the PDF has been generated from the (possibly edited) sections
  pdfGenerated   Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  crisisEvent CrisisEvent @relation(fields: [crisisEventId], references: [id], onDelete: Cascade)
  generatedBy User        @relation(fields: [generatedById], references: [id], onDelete: Cascade)

  @@index([crisisEventId, createdAt(sort: Desc)])
  @@index([generatedById, createdAt(sort: Desc)])
}

model OCRScan {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String        @db.ObjectId
  folderId         String?       @db.ObjectId
  fileId           String?       @db.ObjectId
  crisisEventId    String?       @db.ObjectId
  incidentReportId String?       @db.ObjectId
  sourceImageUrl   String
  sourceFileName   String
  provider         String
  status           String        @default("COMPLETED")
  rawText          String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder         SecureFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  file           FolderFile?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  crisisEvent    CrisisEvent?    @relation(fields: [crisisEventId], references: [id], onDelete: SetNull)
  incidentReport IncidentReport? @relation(fields: [incidentReportId], references: [id], onDelete: SetNull)
  items          OCRItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([folderId, createdAt(sort: Desc)])
  @@index([crisisEventId, createdAt(sort: Desc)])
  @@index([incidentReportId, createdAt(sort: Desc)])
}

model OCRItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  scanId     String   @db.ObjectId
  text       String
  confidence Float?
  category   String
  bboxLeft   Float?
  bboxTop    Float?
  bboxWidth  Float?
  bboxHeight Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  scan OCRScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

// ═══════════════════════════════════════════════════════════════════════════
// TRACK B: Evidence Graph, Contradiction Radar, Assignments, Needs, Copilot
// ═══════════════════════════════════════════════════════════════════════════

enum ClaimType {
  ROAD_ACCESS
  CASUALTY_ESTIMATE
  RESOURCE_NEED
  DAMAGE_ASSESSMENT
  HAZARD_STATUS
  LOCATION_UPDATE
  OTHER
}

enum EvidenceState {
  SINGLE_SOURCE
  PARTIALLY_CORROBORATED
  CORROBORATED
  CONFLICTED
  COORDINATOR_VERIFIED
  OFFICIAL_CONFIRMED
  REJECTED
  STALE
}

enum EvidenceEdgeType {
  SUPPORTS
  CONTRADICTS
  DUPLICATES
  SUPERSEDES
  DERIVES_FROM
}

enum AssignmentStatus {
  PROPOSED
  OFFERED
  ACCEPTED
  EN_ROUTE
  ON_SITE
  COMPLETED
  DECLINED
  CANCELLED
  EXPIRED
}

enum AllocationStatus {
  REQUESTED
  HELD
  APPROVED
  READY
  PICKED_UP
  DELIVERED
  DECLINED
  CANCELLED
  EXPIRED
}

enum BriefStatus {
  DRAFT
  REVIEWED
  PUBLISHED
  SUPERSEDED
}

enum ActionDraftStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum DecisionAction {
  ACCEPT_CLAIM
  REJECT_CLAIM
  SUPERSEDE_CLAIM
  LINK_SUPPORT
  LINK_CONTRADICTION
  MARK_RESOLVED
  ESCALATE_SEVERITY
}

enum AIProcessingState {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  MANUAL_REVIEW
}

model Claim {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  claimType        ClaimType
  subject          String
  value            String
  unit             String?
  locationText     String?
  latitude         Float?
  longitude        Float?
  observedAt       DateTime?
  validUntil       DateTime?
  crisisEventId    String        @db.ObjectId
  incidentReportId String?       @db.ObjectId
  sourceText       String?
  sourceRecordIds  String[]
  sourceIndependenceGroup String? // reporterId + 5-min window; claims in same group are NOT independent
  evidenceState    EvidenceState @default(SINGLE_SOURCE)
  needsHumanDecision Boolean     @default(true)
  supersededById   String?       @db.ObjectId
  conflictCount    Int           @default(0)
  supportCount     Int           @default(1)
  createdById      String        @db.ObjectId
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  crisisEvent    CrisisEvent     @relation(fields: [crisisEventId], references: [id], onDelete: Cascade)
  incidentReport IncidentReport? @relation(fields: [incidentReportId], references: [id], onDelete: SetNull)
  createdBy      User            @relation(fields: [createdById], references: [id])
  needsByNeed    Need[]
  supersededBy   Claim?          @relation("Supersedes", fields: [supersededById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersedes     Claim[]         @relation("Supersedes")
  edgesFrom      EvidenceEdge[]  @relation("EdgeFrom")
  edgesTo        EvidenceEdge[]  @relation("EdgeTo")

  @@index([crisisEventId, evidenceState])
  @@index([crisisEventId, claimType])
}

model EvidenceEdge {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  fromClaimId String           @db.ObjectId
  toClaimId   String           @db.ObjectId
  edgeType    EvidenceEdgeType
  reason      String?
  createdById String           @db.ObjectId
  createdAt   DateTime         @default(now())

  fromClaim Claim @relation("EdgeFrom", fields: [fromClaimId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toClaim   Claim @relation("EdgeTo",   fields: [toClaimId],   references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([fromClaimId])
  @@index([toClaimId])
}

model Decision {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  action        DecisionAction
  crisisEventId String         @db.ObjectId
  claimId       String?        @db.ObjectId
  edgeId        String?        @db.ObjectId
  actorId       String         @db.ObjectId
  reason        String
  beforeState   String?
  afterState    String?
  createdAt     DateTime       @default(now())

  crisisEvent CrisisEvent @relation(fields: [crisisEventId], references: [id], onDelete: Cascade)
  actor       User        @relation(fields: [actorId], references: [id])

  @@index([crisisEventId, createdAt(sort: Desc)])
}

model AIAnalysis {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  incidentReportId String?           @db.ObjectId
  crisisEventId    String?           @db.ObjectId
  provider         String
  model            String
  promptVersion    String            @default("v1")
  inputSourceIds   String[]
  outputJson       String?
  state            AIProcessingState @default(QUEUED)
  errorMessage     String?
  latencyMs        Int?
  createdAt        DateTime          @default(now())
  completedAt      DateTime?

  incidentReport IncidentReport? @relation(fields: [incidentReportId], references: [id], onDelete: SetNull)
  crisisEvent    CrisisEvent?    @relation(fields: [crisisEventId], references: [id], onDelete: SetNull)

  @@index([state, createdAt])
}

// §10.3: Signal — raw incoming signal before it becomes an IncidentReport.
// Tracks the processing lifecycle from receipt through triage to linking.
model Signal {
  id                String                 @id @default(auto()) @map("_id") @db.ObjectId
  incidentReportId  String?                @db.ObjectId
  processingState   SignalProcessingState  @default(RECEIVED)
  // Raw payload hash for deduplication
  payloadHash       String?
  // Channel through which the signal arrived
  channel           String   // "WEB" | "VOICE" | "OCR" | "API" | "OFFLINE_SYNC"
  // Idempotency key from the submission
  idempotencyKey    String?  @unique
  // Processing metadata
  receivedAt        DateTime @default(now())
  processedAt       DateTime?
  rejectedReason    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  incidentReport IncidentReport? @relation("SignalToReport", fields: [incidentReportId], references: [id], onDelete: SetNull)

  @@index([processingState, receivedAt])
  @@index([channel, receivedAt(sort: Desc)])
}

// §10.3: SourceAsset — the original media or text asset from which claims are extracted.
// Links a Claim to its provenance (which media file, which report text, which OCR output).
model SourceAsset {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  crisisEventId   String?  @db.ObjectId
  incidentReportId String? @db.ObjectId
  mediaAssetId    String?  @db.ObjectId
  // Type of source: TEXT, IMAGE, VIDEO, AUDIO, OCR, EXTERNAL_FEED
  assetType       String
  // The raw content reference (file path, URL, or text snippet)
  contentRef      String
  // Metadata about the source
  capturedAt      DateTime?
  sourceSystem    String?  // "USER_REPORT", "RESPONDER_UPDATE", "FFWC", "NEWS_FEED"
  // Integrity
  checksum        String?
  createdAt       DateTime @default(now())

  crisisEvent    CrisisEvent? @relation(fields: [crisisEventId], references: [id], onDelete: SetNull)
  incidentReport IncidentReport? @relation("SourceAssetToReport", fields: [incidentReportId], references: [id], onDelete: SetNull)
  mediaAsset     MediaAsset?   @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([crisisEventId, assetType])
  @@index([incidentReportId])
}

model Need {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  crisisEventId  String   @db.ObjectId
  needType       String
  description    String
  quantity       Int
  unit           String
  urgency        String
  isMet          Boolean  @default(false)
  sourceClaimId  String?  @db.ObjectId
  dueAt          DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  crisisEvent  CrisisEvent  @relation(fields: [crisisEventId], references: [id], onDelete: Cascade)
  sourceClaim  Claim?       @relation(fields: [sourceClaimId], references: [id], onDelete: SetNull)
  assignments  Assignment[]
  allocations  Allocation[]

  @@index([crisisEventId, isMet])
}

model Assignment {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  crisisEventId   String           @db.ObjectId
  needId          String?          @db.ObjectId
  volunteerId     String           @db.ObjectId
  status          AssignmentStatus @default(PROPOSED)
  proposedById    String           @db.ObjectId
  proposedAt      DateTime         @default(now())
  offeredAt       DateTime?
  acceptedAt      DateTime?
  completedAt     DateTime?
  declinedAt      DateTime?
  declineReason   String?
  cancelledAt     DateTime?
  cancelReason    String?
  outcomeNote     String?
  outcomeApproved Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  crisisEvent CrisisEvent @relation(fields: [crisisEventId], references: [id], onDelete: Cascade)
  need        Need?       @relation(fields: [needId], references: [id], onDelete: SetNull)
  volunteer   User        @relation("AssignmentVolunteer", fields: [volunteerId], references: [id])
  proposedBy  User        @relation("AssignmentProposer", fields: [proposedById], references: [id])

  @@index([crisisEventId, status])
  @@index([volunteerId, status])
}

model Allocation {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  needId         String           @db.ObjectId
  resourceId     String           @db.ObjectId
  quantity       Int
  status         AllocationStatus @default(REQUESTED)
  requestedById  String           @db.ObjectId
  approvedById   String?          @db.ObjectId
  approvedAt     DateTime?
  deliveredAt    DateTime?
  deliveryNote   String?
  idempotencyKey String?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  need        Need     @relation(fields: [needId], references: [id], onDelete: Cascade)
  resource    Resource @relation(fields: [resourceId], references: [id])
  requestedBy User     @relation("AllocationRequester", fields: [requestedById], references: [id])
  approvedBy  User?    @relation("AllocationApprover", fields: [approvedById], references: [id])
  fulfillments Fulfillment[]

  @@index([needId, status])
  @@index([resourceId, status])
}

model SituationBrief {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  crisisEventId  String      @db.ObjectId
  version        Int
  status         BriefStatus @default(DRAFT)
  cutOffAt       DateTime
  content        String
  changedFacts   String[]
  unresolvedConflicts String[]
  sourceClaimIds String[]
  generatedById  String      @db.ObjectId
  reviewedById   String?     @db.ObjectId
  publishedAt    DateTime?
  supersededById String?     @db.ObjectId @unique
  createdAt      DateTime    @default(now())

  crisisEvent  CrisisEvent     @relation(fields: [crisisEventId], references: [id], onDelete: Cascade)
  generatedBy  User            @relation("BriefGenerator", fields: [generatedById], references: [id])
  reviewedBy   User?           @relation("BriefReviewer", fields: [reviewedById], references: [id])
  supersededBy SituationBrief? @relation("BriefSupersedes_Fwd", fields: [supersededById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersedes   SituationBrief? @relation("BriefSupersedes_Fwd")

  @@index([crisisEventId, status])
  @@unique([crisisEventId, version])
}

model AuditEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String?  @db.ObjectId
  actorRole  String?
  action     String
  targetType String
  targetId   String?
  reason     String?
  beforeJson String?
  afterJson  String?
  requestId  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
}

model IdempotencyKey {
  id        String   @id @map("_id")
  userId    String?  @db.ObjectId
  operation String
  resultId  String?
  state     String   @default("COMPLETED")
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model ActionDraft {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  crisisEventId String          @db.ObjectId
  draftType    String           // DISPATCH | ALLOCATION | STATUS_CHANGE | ALERT
  payload      String           // JSON
  reasoning    String
  sourceIds    String[]
  status       ActionDraftStatus @default(PENDING)
  proposedById String           @db.ObjectId
  confirmedById String?         @db.ObjectId
  confirmedAt  DateTime?
  expiresAt    DateTime
  createdAt    DateTime         @default(now())

  crisisEvent CrisisEvent @relation(fields: [crisisEventId], references: [id], onDelete: Cascade)
  proposedBy  User        @relation("DraftProposer", fields: [proposedById], references: [id])
  confirmedBy User?       @relation("DraftConfirmer", fields: [confirmedById], references: [id])

  @@index([crisisEventId, status])
  @@index([status, expiresAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// TRACK C: Missing models from refinement plan
// ═══════════════════════════════════════════════════════════════════════════

// FR-01: Organization boundary for institutional customers
model Organization {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  type            OrganizationType @default(NGO)
  description     String?
  adminIds        String[]
  deploymentScope String?  // e.g. "dhaka-district" or "national"
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  users         User[]
  crisisEvents  CrisisEvent[]

  @@index([type, isActive])
}

// FR-01: Responder profile with approval workflow
model ResponderProfile {
  id                  String                  @id @default(auto()) @map("_id") @db.ObjectId
  userId              String                  @unique @db.ObjectId
  approvalStatus      ResponderApprovalStatus @default(APPLICANT)
  approvedSkills      String[]
  certifications      String[]
  availabilityStatus  String?  // "AVAILABLE" | "BUSY" | "OFF_DUTY"
  availabilityExpiry  DateTime?
  operatingAreaLat    Float?
  operatingAreaLng    Float?
  operatingAreaText   String?
  assignmentReliability Float                  @default(0)
  completedMissions   Int                     @default(0)
  coordinatorNotes    String?
  reviewedById        String?                 @db.ObjectId
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvalStatus])
}

// FR-10: Private media asset with opaque storage key
model MediaAsset {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  storageKey        String         @unique  // opaque key, never a public disk path
  originalFileName  String
  contentType       String
  verifiedMimeType  String?  // from magic-byte validation
  sizeBytes         Int
  checksum          String?
  visibility        MediaVisibility @default(PRIVATE)
  crisisEventId     String?        @db.ObjectId
  uploaderId        String         @db.ObjectId
  capturedAt        DateTime?
  uploadedAt        DateTime       @default(now())
  // Consent for third-party AI processing
  aiConsent         Boolean        @default(false)
  consentVersion    String?
  // Retention
  retentionDays     Int?
  deletedAt         DateTime?
  // Derivative relation (e.g. OCR from an image)
  derivativeOfId    String?        @db.ObjectId
  // Versioning
  version           Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  crisisEvent   CrisisEvent?  @relation(fields: [crisisEventId], references: [id], onDelete: SetNull)
  uploader      User          @relation(fields: [uploaderId], references: [id])
  derivativeOf  MediaAsset?   @relation("DerivativeRelation", fields: [derivativeOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  derivatives   MediaAsset[]  @relation("DerivativeRelation")
  sourceAssets  SourceAsset[]

  @@index([crisisEventId, visibility])
  @@index([uploaderId, createdAt(sort: Desc)])
  @@index([visibility, deletedAt])
}

// FR-08: Atomic stock ledger for race-free inventory
model StockLedgerEntry {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  resourceId      String         @db.ObjectId
  entryType       StockEntryType
  quantity        Int            // positive for INCREMENT/HOLD, negative for DECREMENT
  allocationId    String?        @db.ObjectId
  idempotencyKey  String?
  reason          String?
  actorId         String         @db.ObjectId
  createdAt       DateTime       @default(now())

  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([resourceId, createdAt(sort: Desc)])
  @@index([allocationId])
  @@index([idempotencyKey])
}

// FR-08: Fulfillment record for delivered resources
model Fulfillment {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  allocationId      String   @db.ObjectId
  deliveredQuantity Int
  deliveredAt       DateTime @default(now())
  recipientName     String?
  verificationNote  String?
  evidenceUrls      String[]
  recordedById      String   @db.ObjectId
  createdAt         DateTime @default(now())

  allocation  Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  recordedBy  User       @relation(fields: [recordedById], references: [id])

  @@index([allocationId, createdAt(sort: Desc)])
}

// FR-09/11: Transactional outbox for durable side effects
model OutboxJob {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  jobType         OutboxJobType
  state           OutboxJobState @default(PENDING)
  payloadJson     String
  dedupeKey       String?
  targetEntityId  String?        @db.ObjectId
  crisisEventId   String?        @db.ObjectId
  actorId         String?        @db.ObjectId
  attempts        Int            @default(0)
  maxAttempts     Int            @default(5)
  lastError       String?
  availableAt     DateTime       @default(now())
  lockedAt        DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())

  crisisEvent CrisisEvent? @relation(fields: [crisisEventId], references: [id], onDelete: SetNull)
  actor       User?        @relation(fields: [actorId], references: [id])

  @@index([state, availableAt])
  @@index([dedupeKey])
  @@index([jobType, state])
}

// ── Trust Tier System: Vouching ────────────────────────────────────────────
// An approved responder (Tier 2+) can vouch for a volunteer, fast-tracking
// them to Trainee (Tier 1) without needing 30 points. One vouch per volunteer
// is enough — it means "I know this person, they're reliable."
model Vouch {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  vouchedById     String   @db.ObjectId
  vouchedForId    String   @db.ObjectId
  reason          String
  crisisEventId   String?  @db.ObjectId  // optional: vouching in context of a crisis
  createdAt       DateTime @default(now())

  vouchedBy     User @relation("VouchGiven", fields: [vouchedById], references: [id], onDelete: Cascade)
  vouchedFor    User @relation("VouchReceived", fields: [vouchedForId], references: [id], onDelete: Cascade)

  @@unique([vouchedForId])  // one vouch per volunteer is enough
  @@index([vouchedById])
}

// ── Crisis Chat: async message board scoped to a crisis event ───────────────
model CrisisMessage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  crisisEventId   String   @db.ObjectId
  senderId        String   @db.ObjectId
  content         String
  isPinned        Boolean  @default(false)
  isDeleted       Boolean  @default(false)
  deletedById     String?  @db.ObjectId
  deletedAt       DateTime?
  createdAt       DateTime @default(now())

  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([crisisEventId, createdAt])
  @@index([senderId])
}
